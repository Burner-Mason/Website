# Burner Mason API — environment variables.
# Copy to `.env` for LOCAL testing only. NEVER commit a real .env.
# In production these come from Cloud Run / Secret Manager.

# --- Stripe (TEST keys for now; swap to live later) ---
STRIPE_SECRET_KEY=sk_test_xxx
# From `stripe listen` locally, or the Stripe Dashboard webhook endpoint in prod.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- Shippo ---
SHIPPO_TOKEN=shippo_test_xxx

# --- Storefront wiring ---
# Exact origin allowed to call this API (your live storefront, no trailing slash).
ALLOWED_ORIGIN=https://burnermason.com
# Base URL of the storefront, used to build success/cancel links.
STOREFRONT_URL=https://burnermason.com

# --- Ship-from (your business / Stripe Atlas address) ---
BUSINESS_NAME=Burner Mason
BUSINESS_STREET1=123 Main St
BUSINESS_STREET2=
BUSINESS_CITY=Denver
BUSINESS_STATE=CO
BUSINESS_ZIP=80202
BUSINESS_COUNTRY=US
BUSINESS_PHONE=
BUSINESS_EMAIL=spook@spookylabs.ai
